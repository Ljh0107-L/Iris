{
  "name": "iris",
  "version": "0.1.12",
  "description": "One desktop app for your coding agents: Pi, Claude Code, Codex and Antigravity, on this Mac and over SSH",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --mac --publish never",
    "test": "node --test \"test/*.test.mjs\"",
    "test:ui": "vite build && node test/conversation-ui.mjs && node test/git-review-ui.mjs",
    "test:integration": "vite build && sh test/integration.sh"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "node-pty": "^1.1.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^8.0.4",
    "dompurify": "^3.4.17",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "highlight.js": "^11.12.0",
    "katex": "0.19.0",
    "lucide-react": "^1.66.0",
    "marked": "^15.0.12",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "main": "app/main/main.mjs",
  "author": "Ljh0107-L",
  "homepage": "https://github.com/Ljh0107-L/Iris",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ljh0107-L/Iris.git"
  },
  "build": {
    "appId": "io.github.ljh0107-l.iris",
    "productName": "Iris",
    "copyright": "Copyright © 2026 Iris contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "app/main/**",
      "agent/**",
      "core/**",
      "dist/renderer/**",
      "build/icon.png",
      "!**/*.map"
    ],
    "asar": false,
    "afterPack": "build/after-pack.cjs",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "Iris works in the folders you choose.",
        "NSDocumentsFolderUsageDescription": "Iris works in the folders you choose.",
        "NSDownloadsFolderUsageDescription": "Iris works in the folders you choose."
      }
    },
    "dmg": {
      "title": "Iris ${version}"
    },
    "artifactName": "Iris-${version}-${arch}-mac.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Ljh0107-L",
        "repo": "Iris",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false
  },
  "bugs": {
    "url": "https://github.com/Ljh0107-L/Iris/issues"
  }
}
